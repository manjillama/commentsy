NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=
NEXTAUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Winston log threshold (error, warn, info, debug). Default: info.
LOG_LEVEL=info

# Optional browser key for the KLIPY GIF picker (public by design).
NEXT_PUBLIC_KLIPY_API_KEY=

# Optional exact external origins allowed after sign-in (comma-separated).
# AUTH_REDIRECT_ORIGINS=https://blog.example.com,https://www.example.com
AUTH_REDIRECT_ORIGINS=

# Optional IP header overwritten by your trusted reverse proxy.
# Vercel is detected automatically. Unset on other hosts uses shared limits.
RATE_LIMIT_IP_HEADER=

# Optional replica set URI to enable integration tests (passed to npm test).
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
